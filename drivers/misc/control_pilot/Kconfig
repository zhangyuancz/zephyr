config CONTROL_PILOT
	bool "GB/T 18487.1 control-pilot driver"
	default y
	depends on DT_HAS_ZEPHYR_CONTROL_PILOT_ENABLED
	depends on PWM
	depends on ADC
	depends on GPIO
	select ADC_ASYNC
	help
	  Enable the GB/T 18487.1 control-pilot (CP) driver. Generates the CP PWM and
	  continuously acquires the hardware-triggered ADC and optional PWM feedback
	  in interrupt callbacks. The latest voltage, states 0 through 4, diode input,
	  and PWM feedback can then be read without waiting for a conversion.

if CONTROL_PILOT

config CONTROL_PILOT_INIT_PRIORITY
	int "Control-pilot init priority"
	default 91
	help
	  Control-pilot driver initialization priority in POST_KERNEL. Must be
	  after the PWM, ADC and GPIO drivers.

module = CONTROL_PILOT
module-str = control_pilot
source "subsys/logging/Kconfig.template.log_config"

endif # CONTROL_PILOT
