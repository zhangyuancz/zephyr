#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/dma/gd32_dma.h>

/* Hardware TRNG provides entropy for the network stack / TLS. */
&trng0 {
	status = "okay";
};

&usart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
	dmas = <&dma1 2 4 GD32_DMA_PRIORITY_VERY_HIGH 3>,
	       <&dma1 7 4 GD32_DMA_PRIORITY_HIGH 3>;
	dma-names = "rx", "tx";

	modem: l511 {
		compatible = "lynq,l511";
		mdm-power-gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
		mdm-reset-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
	};
};
