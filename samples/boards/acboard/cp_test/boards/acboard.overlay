#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/gd32e50x.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		io-channels = <&adc0 11>;
		pwms = <&pwm1 2 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
		       <&pwm2 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		cp-diode-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
	};
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_cp_default>;
	pinctrl-names = "default";
	gd,clock-prescaler = <6>;
	gd,external-trigger-source = <GD32E50X_ADC_TRIGGER_TIMER1_CH1>;
	gd,external-trigger-timeout-us = <5000>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&timer1 {
	status = "okay";
	prescaler = <179>;

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&cp_pwm_default>;
		pinctrl-names = "default";
		gd,auxiliary-source-channel = <2>;
		gd,auxiliary-channel = <1>;
		gd,auxiliary-pulse-ratio = <1 2>;
	};
};

&timer2 {
	status = "okay";
	prescaler = <179>;

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&cp_pwm_feedback_default>;
		pinctrl-names = "default";
	};
};
