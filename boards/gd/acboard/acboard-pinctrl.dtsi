#include <dt-bindings/pinctrl/gd32e507v(e-c)xx-pinctrl.h>

&pinctrl {
	usart0_default: usart0_default {
		group1 {
			pinmux = <USART0_TX_PA9_NORMP>, <USART0_RX_PA10_NORMP>;
		};
	};

	uart3_default: uart3_default {
		group1 {
			pinmux = <UART3_TX_PC10>, <UART3_RX_PC11>;
		};
	};
};
