/dts-v1/;

#include <arm/gd/gd32e50x/gd32e513xe.dtsi>
#include "acboard-pinctrl.dtsi"

/ {
	model = "ACBoard";
	compatible = "gd,acboard";

	zephyr,user {
		modem-powerkey-gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
		modem-reset-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
		modem-reset-pulse-ms = <200>;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart3;
		zephyr,shell-uart = &uart3;
		zephyr,modem-uart = &usart0;
		zephyr,flash-controller = &fmc;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioe 8 GPIO_ACTIVE_LOW>;
		};

		led1: led_1 {
			gpios = <&gpioe 9 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		modem-uart = &usart0;
	};
};

&gpioa {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&usart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
	dmas = <&dma0 4 0>, <&dma0 3 0>;
	dma-names = "rx", "tx";
};

&uart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-names = "default";
};
