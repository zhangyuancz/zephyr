config BOARD_ACBOARD_F527
	select SOC_GD32F527
	# System clock source is the GD32_F5XX_SYSCLK_SRC choice (Kconfig.clocks);
	# choice members cannot be 'select'ed here. The board pins it in
	# acboard_f527_defconfig (which reaches both the MCUboot and app images).
