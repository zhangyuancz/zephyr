#include <dt-bindings/pinctrl/gd32f527i(g-i-k)xx-pinctrl.h>

&pinctrl {
	usart0_default: usart0_default {
		group1 {
			pinmux = <USART0_TX_PB6>, <USART0_RX_PB7>;
		};
	};

	usart5_default: usart5_default {
		group1 {
			pinmux = <USART5_TX_PC6>, <USART5_RX_PC7>;
		};
	};
};
